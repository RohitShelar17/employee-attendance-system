# Copy to .env and fill in. Never commit the filled copy.

# --- Database ---
# MYSQL_ROOT_PASSWORD is only read by docker-compose, to initialise the
# container. The application itself never uses the root account.
MYSQL_ROOT_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=attendance_db
DB_USERNAME=attendance_app
DB_PASSWORD=

# --- JWT ---
# Must base64-decode to at least 64 bytes for HS512. Generate a fresh one:
#   openssl rand -base64 64
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# --- Security ---
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30
# Must be true wherever the site is served over HTTPS. The application refuses
# to start with this false outside a dev profile.
REFRESH_COOKIE_SECURE=false

# Requests per source IP to the credential endpoints, per window.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5175,http://localhost:5173,http://localhost:5174

# --- App ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
COMPANY_TIMEZONE=Asia/Kolkata
# Publishes the whole API surface. The application refuses to start with this
# true outside a dev profile.
SWAGGER_ENABLED=true
LOG_LEVEL=DEBUG

# --- Docker compose only ---
FRONTEND_PORT=3000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8090/api/v1

# --- Optional, not yet used ---
MAP_PROVIDER_API_KEY=
